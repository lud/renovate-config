{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Etc/UTC",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "on monday"
    ],
    "commitMessageAction": "Refresh",
    "commitMessageTopic": "lockfile"
  },
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["mix"],
      "matchDepTypes": ["prod"],
      "groupName": "prod deps",
      "groupSlug": "mix-prod"
    },
    {
      "matchManagers": ["mix"],
      "matchDepTypes": ["dev", "test"],
      "groupName": "dev deps",
      "groupSlug": "mix-dev"
    }
  ]
}
